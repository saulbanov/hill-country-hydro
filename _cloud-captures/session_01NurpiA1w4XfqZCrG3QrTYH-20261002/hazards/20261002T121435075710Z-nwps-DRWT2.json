    "impacts": [
      {
        "stage": 25,
        "statement": "Major flooding is near the USGS survey 1:25 year level. Homes in a mobile home park downstream above William Cannon Drive in Austin will flood. Roads and bridges are severely flooded and very dangerous from the headwaters to the Colorado River."
      },
      {
        "stage": 23,
        "statement": "Major flooding makes roads and bridges very dangerous to auto traffic. A mobile home park downstream above William Cannon Drive in Austin will be threatened. Livestock should be moved from vulnerable areas of the flood plain."
      },
      {
        "stage": 20.5,
        "statement": "Major flooding is near the USGS survey 1:10 year level. Livestock are threatened in the flood plain. Roads and bridges are severely flooded and very dangerous from the headwaters to the Colorado River. A mobile home park downstream above William Cannon Drive in Austin will be threatened."
      },
      {
        "stage": 18,
        "statement": "Major flooding is well into the flood plain. Roads and bridges from the headwaters to the Colorado River in Austin are severely flooded and very dangerous. The two Ranch to Market Rd 150 crossings are under 13 feet of water."
      },
      {
        "stage": 15,
        "statement": "Major flooding is near the USGS survey 1:5 year level. Flow is ten feet over the two Ranch to Market Rd 150 crossings and well into the flood plain, threatening livestock. Roads and low bridges are flooded and dangerous from the headwaters to the Colorado River."
      },
      {
        "stage": 13,
        "statement": "Major flooding cuts off livestock in the flood plain from the headwaters to above I-35. Flow is eight feet over the two Ranch to Market Rd 150 crossings. Widespread severe flooding of secondary and primary roads and bridges makes driving very hazardous."
      },
      {
        "stage": 10,
        "statement": "Moderate lowland flooding is five feet over the two Ranch to Market Rd 150 crossings and well into the flood plain."
      },
      {
        "stage": 8.6,
        "statement": "Moderate flooding reaches the USGS survey 1:2 year flood level. Flow is three feet over the two Ranch to Market Rd 150 crossings."
      },
      {
        "stage": 7,
        "statement": "Moderate lowland flooding makes secondary roads, low bridges and low water crossings very dangerous. The two Ranch to Market Rd 150 crossings may be under several feet of fast flowing water."
      },
      {
        "stage": 5.5,
        "statement": "Minor flooding makes several secondary roads dangerous, including the two Ranch to Market Rd 150 crossings over Onion Creek."
      }
    ]
  },
