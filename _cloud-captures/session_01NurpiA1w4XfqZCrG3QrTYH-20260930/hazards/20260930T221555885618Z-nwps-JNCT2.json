    "impacts": [
      {
        "stage": 31,
        "statement": "Major flooding will occur. Numerous roads and low water crossings will be flooded and impassible. Structures along the Llano River in and near Junction will be flooded."
      },
      {
        "stage": 22,
        "statement": "Moderate flooding will occur. Roads and low water crossings will be flooded and impassible."
      },
      {
        "stage": 16,
        "statement": "Minor lowland flooding will occur to ranch land. Secondary roads and low water crossings will be flooded."
      },
      {
        "stage": 15,
        "statement": "The Bogs Stream, 2 miles east of Interstate 10 on FM2169, will become impassable due to floodwaters from the Llano River. "
      },
      {
        "stage": 13,
        "statement": "The Bogs Stream, 2 miles east of Interstate 10 on FM 2169, will begin inundating with floodwaters from the Llano River."
      }
    ]
