    "impacts": [
      {
        "stage": 31,
        "statement": "Water reaches the floor of the Highway 78 bridge."
      },
      {
        "stage": 22,
        "statement": "Major flooding severely floods a trailer park in Schertz. Major lowland flooding damages crop and pasture land below Bulverde to below Falls City, flooding secondary roads and low bridges."
      },
      {
        "stage": 20,
        "statement": "A trailer park downstream in Schertz floods. Flow approaches lowest businesses and residences in Schertz. Moderate lowland flooding damages crop and pasture land in the flood plain below Bulverde to below Stockdale."
      },
      {
        "stage": 18,
        "statement": "River has reached the floor of the bridge at the intersection of Lookout Road and North Evans Road near the gauge. "
      },
      {
        "stage": 17,
        "statement": "Minor lowland flooding floods a trailer park downstream in Schertz. Moderate lowland flooding in the flood plain below Bulverde to below Stockdale floods secondary roads and bridges near the creek."
      }
