    "impacts": [
      {
        "stage": 13,
        "statement": "Widespread flooding is making secondary roads, low bridges, and crossings very dangerous from the headwaters to town lake. Lowest homes in the flood plain are threatened. Flow is approaching the USGS 1:25 year flood level of 13.8 feet."
      },
      {
        "stage": 11.8,
        "statement": "Major flooding is near the USGS 1:10 year flood level of 11,000 CFS. Streets, roads and bridges in the flood plain are severely flooded and dangerous to motorists."
      },
      {
        "stage": 9,
        "statement": "Major flooding makes the bridge at FM 2222 and Shoal Creek very dangerous to motorists. Several streets and low crossings are flooded from the headwaters to town lake. Flow approaches the USGS 1:5 year flood level of 9.8 feet. "
      },
      {
        "stage": 7,
        "statement": "Flooding covers the low bridge at FM 2222 at Bull Creek. Motorists should use care approaching this bridge. Flow is near the USGS 1:2 year flood level of 6.9 feet."
      },
      {
        "stage": 5,
        "statement": "Moderate lowland flooding reaches into lowest areas of the flood plain."
      },
      {
        "stage": 4,
        "statement": "Overbank conditions put water over lowest sections of the banks."
      }
    ]
