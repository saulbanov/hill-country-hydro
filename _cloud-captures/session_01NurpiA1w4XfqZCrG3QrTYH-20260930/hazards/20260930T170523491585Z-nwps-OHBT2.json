    "impacts": [
      {
        "stage": 24,
        "statement": "Major lowland flooding damages any facilities in the flood plain below Highway 71 to Lady Bird Lake. Primary and secondary roads in the Barton Creek flood plain are extremely dangerous to motorists. Barton Springs Pool suffers significant damage."
      },
      {
        "stage": 20,
        "statement": "Widespread major lowland flooding below Highway 71 inundates many secondary roads, bridges, and streets. Barton Springs Pool downstream sustains significant damage."
      },
      {
        "stage": 18,
        "statement": "Major lowland flooding. Flow is one-hundred yards wide at Highway 71 at Barton Creek. Secondary roads and bridges downstream in low areas are flooded and dangerous. Barton Springs Pool floods severely downstream. "
      },
      {
        "stage": 15,
        "statement": "Moderate lowland flooding. Flow is seventy-five yards wide at Highway 71. Lowest secondary roads and bridges flood. Barton Springs Pool downstream floods. "
      },
      {
        "stage": 12,
        "statement": "Minor lowland flooding covers lowest areas of the flood plain. No significant impact at this level."
      }
    ]
