    },
    "impacts": [
      {
        "stage": 26,
        "statement": "Flow is near the USGS 1:100 year flood level (26 feet - 44,400 cfs). Disastrous flooding reaches several homes in the lower flood plain. Streets, roads and bridges are very dangerous to motorists. Barton Springs Pool is severely damaged."
      },
      {
        "stage": 25,
        "statement": "Flow reaches the usgs 1:50 year flood level (34,200 cfs). Major flooding severely damages Barton Springs Pool downstream. Roads, streets and bridges are extremely dangerous to motorists. Lowest residences are threatened."
      },
      {
        "stage": 23,
        "statement": "Major, very dangerous flooding occurs. Many streets and bridges above Loop 360 to the Colorado River are very dangerous. Nearing the USGS 1:50 foot flood level. Barton Springs Pool is severely damaged. Lowest residences are threatened."
      },
      {
        "stage": 22,
        "statement": "The Barton Creek flood plain is very dangerous. Travel should be prohibited on streets and bridges that cross the flood plain. Barton Springs Pool will be severely impacted with major damage. Well in excess of a 1:25 year flood. Lowest residences are threatened."
      },
      {
        "stage": 20,
        "statement": "Flow is in excess of the USGS 1:25 year flood level. Severe flooding damage to Barton Springs Pool downstream. Major flooding makes low lying streets and bridges very dangerous."
      },
      {
        "stage": 18,
        "statement": "Major flooding of the lower flood plain occurs including Barton Springs Pool. Flow reaches the usgs 1:25 year flood level (25,400 cfs). Low roads, streets and bridges are severely flooded and dangerous."
      },
      {
        "stage": 16,
        "statement": "Major flooding causes severe damage to Barton Springs Pool downstream. Roads, streets and bridges are severely flooding and dangerous in the Barton Creek flood plain."
      },
      {
        "stage": 14,
        "statement": "Major flooding covers lower areas of Barton Springs Pool downstream. Jogging and biking trails in the lower flood plain are flooded. Flow is near the USGS 1:10 year flood level of 14.2 feet."
      },
      {
        "stage": 12,
        "statement": "Major flooding puts flow overbanks in Barton Springs Pool downstream. Roads and low bridges are very dangerous above Loop 360 to the Colorado River."
      },
      {
        "stage": 11,
        "statement": "Minor lowland flooding reaches lowest secondary roads and low bridges. Significant rise downstream in Barton Springs Pool."
      },
      {
        "stage": 8,
        "statement": "Flow exceeds lowest sections of the banks."
      }
    ]
  },
