    "impacts": [
      {
        "stage": 11,
        "statement": "Most of a large shopping mall along Highway 290 in Oak Hill is flooded with widespread damages. The Highway 290 bridge is flooded as well as numerous streets and low bridges in the Williamson Creek flood plain."
      },
      {
        "stage": 10,
        "statement": "Major flooding extends across Highway 290 and floods low sections of a large commercial mall along Highway 290 in Oak Hill. Streets, low bridges, and crossings are extremely dangerous to auto traffic."
      },
      {
        "stage": 7,
        "statement": "Flow reaches slabs of lowest commercial buildings in a large maill along Highway 290 in Oak Hill. Motorists should not enter flooded streets and low bridges in the Williamson Creek flood plain."
      },
      {
        "stage": 6,
        "statement": "Flow goes overbanks and threatens lowest commercial buildings along Highway 290 in Oak Hill."
      }
    ]
