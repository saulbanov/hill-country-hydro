    "impacts": [
      {
        "stage": 714,
        "statement": "Flow reaches and goes uncontrolled over the emergency spillway over Mansfield Dam at Lake Travis. Hundreds of homes around Lake Travis flood, many with water well over their roofs or in the second floor level.  "
      },
      {
        "stage": 710,
        "statement": "Hundreds of homes around Lake Travis at Graveyard Point at Lakeway flood with water well over some roofs and into the second floor of lower homes."
      },
      {
        "stage": 705,
        "statement": "Disastrous residential flooding of hundreds of homes occurs around Lake Travis at Graveyard Point at Lakeway, many with water over their roofs in up to 17 feet of water."
      },
      {
        "stage": 700,
        "statement": "Many homes flood at Graveyard Point at Lakeway on Lake Travis, some with water to their roofs in up to twelve feet of water."
      },
      {
        "stage": 695,
        "statement": "Lowest temporary and mobile homes in Graveyard Point at Lakeway on Lake Travis have up to seven feet of water in them."
      },
      {
        "stage": 691,
        "statement": "The lowest permanent homes at Graveyard Point at Lakeway on Lake Travis flood. Several temporary homes are in several feet of water. "
      },
      {
        "stage": 688,
        "statement": "Lowest temporary and mobile homes at Graveyard Point at Lakeway on Lake Travis flood."
      },
      {
        "stage": 685,
        "statement": "The lowest temporary and mobile homes at Lakeway at Graveyard Point on Lake Travis are threatened."
      }
    ]
  },
