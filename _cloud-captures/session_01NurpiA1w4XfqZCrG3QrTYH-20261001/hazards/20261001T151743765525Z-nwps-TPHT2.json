    "impacts": [
      {
        "stage": 30,
        "statement": "Major flooding puts four feet of water in a ranch house and large barn 400 yards into the left flood plain near FM 462. US Highway 90 near Hondo floods over a half mile wide east of the bridge. No residential flooding occurs in Hondo from Hondo Creek. "
      },
      {
        "stage": 26,
        "statement": "Flow reaches the slabs of a house and large barn 400 yards into the left flood plain near FM 462. Secondary and primary roads and bridges are extremely dangerous in the Hondo Creek flood plain. Livestock should be moved from flood prone areas. "
      },
      {
        "stage": 24,
        "statement": "Major flooding reaches the FM 462 bridge floor. Secondary roads and bridges from the headwaters to below Highway 90 are extremely dangerous. Livestock should be removed from the flood plain immediately."
      },
      {
        "stage": 20,
        "statement": "Moderate lowland flooding is well into the flood plain, making low secondary roads and bridges dangerous."
      },
      {
        "stage": 17,
        "statement": "Secondary roads and low bridges flood from the headwaters to above Hondo. Cattle should be moved from flood prone areas of the flood plain. "
      },
      {
        "stage": 15,
        "statement": "Moderate flooding inundates secondary roads and low bridges from the headwaters to above Hondo."
      },
      {
        "stage": 12,
        "statement": "Minor lowland flooding reaches lowest areas of the flood plain with no significant damage. "
      },
      {
        "stage": 10,
        "statement": "Minor lowland flooding covers the lower flood plain. No significant Damage. "
      }
    ]
  },
