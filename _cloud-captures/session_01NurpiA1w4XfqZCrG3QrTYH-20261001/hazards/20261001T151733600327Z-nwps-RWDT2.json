    "impacts": [
      {
        "stage": 23,
        "statement": "Several homes flood below Reagan Wells up to four feet. "
      },
      {
        "stage": 20,
        "statement": "Major flooding damages several homes below Reagan Wells. Crossings over FM 1051 are under up to 15 feet of water, cutting off residential areas."
      },
      {
        "stage": 17,
        "statement": "Several homes are flooded. FM 1050 has over 10 feet of water over some of the low bridges."
      },
      {
        "stage": 13,
        "statement": "Moderate lowland flooding is generally 75 yards wide, and reaches the slabs of lowest homes below Reagan Wells."
      },
      {
        "stage": 10,
        "statement": "Minor lowland flooding reaches into lower areas of the flood plain, flooding FM 1051 severely in several places. "
      },
      {
        "stage": 7,
        "statement": "The river goes out of banks, isolating several residents temporarily along FM 1050 above Highway 83. "
      },
      {
        "stage": 5,
        "statement": "FM 1051 bridge floors flood at several sites below Reagan Wells. "
      }
    ]
